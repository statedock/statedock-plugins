{
  "name": "@statedock/dsh-plugin",
  "version": "0.1.0",
  "type": "module",
  "description": "StateDock shared plan, pickup and update Skills with optional Remote MCP connection.",
  "license": "MIT",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./mcp": "./mcp.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.mjs",
    "mcp.mjs",
    "cordis.patch.yml",
    "skills",
    "locale",
    "logo.png",
    "LICENSE",
    "README.md"
  ],
  "icon": "./logo.png",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.0-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.2.0-rc.2"
  },
  "homepage": "https://statedock.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statedock/statedock-plugins.git",
    "directory": "adapters/deepseek-harness"
  },
  "bugs": {
    "url": "https://github.com/statedock/statedock-plugins/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "mcp",
    "statedock",
    "skills"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
